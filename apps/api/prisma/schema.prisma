// Каталог специалистов — схема БД (PostgreSQL)
// Генерация клиента:  npm run db:generate -w apps/api
// Применение схемы:   npm run db:push -w apps/api

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Пользователи ───────────────────────────

enum Role {
  USER // обычный клиент
  MODERATOR // модерирует отзывы
  ADMIN // полный доступ к админ-панели
}

/// Что пользователь выбрал на стартовом экране. Не влияет на права —
/// определяет только то, какой интерфейс ему показывать.
enum Onboarding {
  CLIENT // ищет специалистов
  SPECIALIST // сам оказывает услуги
  MARKET // пришёл покупать или продавать товары
  WANTED // пришёл в раздел спроса: что людям нужно прямо сейчас
  URGENT // пришёл за срочным: успеть забрать, пока дёшево
  /// Карьера: ищу сотрудника или ищу работу.
  CAREER
}

/// Пользователь Telegram. Создаётся автоматически при первом открытии Mini App.
model User {
  id           String  @id @default(cuid())
  /// Telegram user id. BigInt — id уже вышли за пределы int32.
  telegramId   BigInt  @unique
  username     String?
  firstName    String
  lastName     String?
  /// Фотография из Telegram. Перезаписывается при каждом входе, поэтому
  /// заменить её своей нельзя — для этого есть поле ниже.
  photoUrl     String?
  /// Своя фотография, загруженная в приложении. Если она есть, показывается
  /// именно она: человек выбрал её сознательно, а телеграмная просто
  /// досталась вместе с аккаунтом.
  avatarUrl    String?
  avatarKey    String?
  languageCode String?
  isPremium    Boolean @default(false)
  role         Role    @default(USER)
  isBlocked    Boolean @default(false)
  /// Пользователь заблокировал бота или не начинал с ним чат.
  /// Telegram отвечает 403 — запоминаем, чтобы не тратить лимит запросов.
  botBlocked   Boolean @default(false)

  /// Сколько раз пользователь пытался передать контакты в обход правил.
  /// Первая попытка — повод объяснить правило, регулярные — повод
  /// показать пользователя администратору.
  contactAttempts Int         @default(0)
  /// null — выбор ещё не сделан, показываем стартовый экран.
  onboardedAs     Onboarding?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  /// Если пользователь сам является специалистом — обратная связь на карточку.
  specialist          Specialist?
  reviews             Review[]
  views               ProfileView[]
  favorites           Favorite[]
  reports             Report[]
  conversations       Conversation[]   @relation("ClientConversations")
  messages            Message[]        @relation("SentMessages")
  listings            Listing[]
  payments            Payment[]
  walletEntries       WalletEntry[]
  dealsAsSeller       Deal[]           @relation("DealsAsSeller")
  dealsAsBuyer        Deal[]           @relation("DealsAsBuyer")
  writtenUserReviews  UserReview[]     @relation("WrittenUserReviews")
  receivedUserReviews UserReview[]     @relation("ReceivedUserReviews")
  serviceRequests     ServiceRequest[] @relation("ServiceRequests")
  generatedImages     GeneratedImage[]

  /// Остаток звёзд на балансе. Хранится числом ради скорости: считать
  /// его по всем движениям на каждый показ экрана слишком дорого.
  /// Достоверность обеспечивает то, что число и движение всегда
  /// меняются в одной транзакции.
  starsBalance Int @default(0)

  /// Когда выданы приветственные звёзды. Пусто — ещё не выдавались.
  /// Отдельное поле, а не поиск по движениям кошелька: подарок разовый,
  /// и проверять это надо надёжно, а не перебором истории.
  welcomeBonusAt DateTime?

  /// Кто пригласил. Записывается при первом входе по ссылке и больше
  /// не меняется: приглашение бывает однажды.
  referrerId String?
  referrer   User?   @relation("Referrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals  User[]  @relation("Referrals")

  /// Когда приглашённый сделал первое дело — выложил объявление или подал
  /// анкету. До этого момента он не засчитывается: иначе приглашением
  /// считался бы простой переход по ссылке, который ничего не стоит.
  referralQualifiedAt DateTime?

  referralAwards ReferralAward[]
  demandWatches  DemandWatch[]
  urgentAsClient UrgentRequest[] @relation("UrgentAsClient")
  urgentAsMaster UrgentRequest[] @relation("UrgentAsMaster")

  @@index([role])
  @@map("users")
}

// ─────────────────────────── Категории ───────────────────────────

/// Что размещается в категории: услуги или товары.
/// Наборы разные — «Ремонт и стройка» как категория товара бессмысленна,
/// но админка и модель остаются общими.
enum CategoryKind {
  SERVICE
  PRODUCT
  /// Отрасли для вакансий и резюме: «Транспорт и логистика», «Кафе».
  JOB
}

/// Категория: «Ремонт», «Красота» — для услуг; «Электроника», «Одежда» — для товаров.
model Category {
  id       String       @id @default(cuid())
  kind     CategoryKind @default(SERVICE)
  /// Человекочитаемый идентификатор для URL: "beauty", "repair".
  slug     String       @unique
  name     String
  /// Emoji или имя иконки из набора фронтенда.
  icon     String       @default("🔧")
  /// Родительская категория — на будущее, для подкатегорий. null = корневая.
  parentId String?
  parent   Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]   @relation("CategoryTree")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialists SpecialistCategory[]

  listings       ListingCategory[]
  attributes     CategoryAttribute[]
  demandWatches  DemandWatch[]
  urgentRequests UrgentRequest[]

  @@index([kind, isActive, sortOrder])
  @@map("categories")
}

// ─────────────────────────── Специалисты ───────────────────────────

enum SpecialistStatus {
  DRAFT // черновик, не виден в каталоге
  PENDING // подана заявка, ждёт проверки админом
  ACTIVE // опубликован
  HIDDEN // скрыт админом или по окончании подписки
  BLOCKED // заблокирован за нарушения
}

/// Карточка специалиста в каталоге.
model Specialist {
  id     String  @id @default(cuid())
  /// Telegram-аккаунт владельца карточки. null — карточку завёл админ вручную.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  slug        String  @unique
  /// Краткая строка под именем: «Мастер маникюра, 8 лет опыта».
  headline    String?
  about       String? @db.Text
  photoUrl    String?
  /// Ключ файла аватара в хранилище. Нужен, чтобы удалить прежний при замене:
  /// по одному URL это невозможно, у драйверов разные схемы адресов.
  photoKey    String?

  // — Локация —
  city    String
  address String?
  /// Координаты для карты и поиска «рядом». null — не показывается на карте.
  lat     Float?
  lng     Float?

  // — Контакты. Приложение не хранит переписку, только точки входа. —
  phone     String?
  telegram  String? // @username или ссылка t.me
  whatsapp  String? // номер в международном формате
  instagram String?
  website   String?

  status SpecialistStatus @default(PENDING)

  /// Анкета опубликована, но владелец её изменил — нужна повторная проверка.
  /// Карточка при этом остаётся видимой: снимать с публикации из-за правки
  /// опечатки слишком грубо, а изменения всё равно попадут к модератору.
  needsReview Boolean @default(false)

  /// Причина отклонения анкеты. Показывается владельцу, чтобы он понимал,
  /// что исправить, и мог подать её заново.
  rejectionReason String?

  /// Кто завёл карточку: сам специалист через приложение или администратор.
  isSelfRegistered Boolean @default(false)

  /// Денормализованный рейтинг: пересчитывается при модерации отзыва.
  /// Хранится здесь, чтобы сортировка и фильтры каталога не делали агрегат на лету.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  viewCount   Int   @default(0)

  /// Платная подписка. Оплата вне приложения, админ ставит отметку вручную.
  subscriptionUntil DateTime?
  /// Поднятие в выдаче для оплативших.
  isPromoted        Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  categories    SpecialistCategory[]
  services      Service[]
  photos        SpecialistPhoto[]
  reviews       Review[]
  views         ProfileView[]
  favorites     Favorite[]
  subscriptions Subscription[]
  conversations Conversation[]
  requests      ServiceRequest[]

  @@index([status, ratingAvg])
  @@index([status, needsReview])
  @@index([city, status])
  @@index([lat, lng])
  @@map("specialists")
}

/// Связь многие-ко-многим: специалист может работать в нескольких категориях.
model SpecialistCategory {
  specialistId String
  categoryId   String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([specialistId, categoryId])
  @@index([categoryId])
  @@map("specialist_categories")
}

/// Позиция прайс-листа. Цены информационные — платежи приложение не проводит.
model Service {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Цена в минимальных единицах (копейках), чтобы не ловить ошибки float.
  priceAmount Int?
  currency    String  @default("RUB")
  /// true — «от 1500 ₽», false — фиксированная цена.
  priceIsFrom Boolean @default(false)
  sortOrder   Int     @default(0)

  @@index([specialistId, sortOrder])
  @@map("services")
}

/// Фотография в галерее работ.
model SpecialistPhoto {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  url        String
  /// Ключ в хранилище — по нему файл удаляется вместе с записью.
  storageKey String?
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([specialistId, sortOrder])
  @@map("specialist_photos")
}

// ─────────────────────────── Объявления ───────────────────────────

enum ListingStatus {
  DRAFT // черновик
  PENDING // ждёт проверки
  ACTIVE // опубликовано
  SOLD // продано, остаётся в истории продавца
  HIDDEN // снято с публикации
  REJECTED // отклонено модератором
}

enum ListingCondition {
  NEW // новый
  USED_PERFECT // как новый
  USED // бывший в употреблении
}

/// Объявление о продаже товара.
///
/// Отдельно от карточки специалиста: у товара цена, состояние и признак
/// «продано», у специалиста — рейтинг, услуги и режим работы. Общая таблица
/// заставила бы половину полей быть пустыми у каждой из сторон.
/// Кто разместил объявление и чего хочет.
enum ListingKind {
  /// Продаю вещь. Обычная витрина: предложение ищет спрос.
  SELL
  /// Ищу вещь. Обратная витрина: объявление даёт покупатель,
  /// а откликаются продавцы. Цена здесь — сколько покупатель готов дать.
  BUY
  /// Ищу сотрудника. Цена — нижняя граница оплаты, «от».
  JOB
  /// Ищу работу. Цена — сколько человек рассчитывает получать.
  RESUME
}

model Listing {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Две витрины живут в одной таблице: у них совпадает всё —
  /// проверка модератором, фотографии, категории, переписка, — и
  /// различаются только тексты в интерфейсе и направление сделки.
  kind ListingKind @default(SELL)

  title       String
  slug        String  @unique
  description String? @db.Text

  /// Цена в минимальных единицах (копейках) — как и у услуг,
  /// чтобы не ловить ошибки округления.
  priceAmount  Int
  currency     String  @default("RUB")
  /// Цена договорная: сумма показывается как ориентир.
  isNegotiable Boolean @default(false)

  /// Продать срочно: человек готов уступить ради скорости.
  /// Такие объявления живут в отдельной витрине — её листают охотнее
  /// обычной, потому что там всегда есть повод поторопиться.
  isUrgent Boolean @default(false)

  /// До какого момента объявление считается срочным. После этого оно
  /// остаётся на общей витрине, но из срочной уходит: раздел, где
  /// «срочное» месячной давности, перестаёт что-либо значить.
  urgentUntil DateTime?

  /// Что автор запроса готов отдать взамен. Заполняется только у запросов
  /// на покупку: в объявлении о продаже обменом распоряжается покупатель.
  /// Пусто — сделка только за деньги.
  exchangeFor String?

  condition ListingCondition @default(USED)
  city      String

  status          ListingStatus @default(PENDING)
  rejectionReason String?
  /// Опубликованное объявление изменили — нужна повторная проверка.
  needsReview     Boolean       @default(false)

  viewCount Int @default(0)

  /// До какого момента объявление держится в начале списка.
  /// Пусто — обычное объявление; прошедшая дата — продвижение кончилось.
  /// Хранится датой, а не флагом, чтобы срок истекал сам, без задания в cron.
  promotedUntil DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  soldAt      DateTime?

  categories    ListingCategory[]
  attributes    ListingAttribute[]
  photos        ListingPhoto[]
  conversations Conversation[]
  deals         Deal[]
  payments      Payment[]

  @@index([kind, status, createdAt])
  /// Отдельный индекс под выдачу с продвижением наверху.
  @@index([kind, status, promotedUntil])
  @@index([city, status])
  @@index([userId])
  @@map("listings")
}

/// Что за характеристика: от этого зависит и поле в форме, и вид фильтра.
enum AttributeKind {
  /// Выбор одного значения из списка: марка, цвет, коробка передач.
  SELECT
  /// Число с единицей измерения: пробег, диагональ, год выпуска.
  NUMBER
  /// Да или нет: «торг уместен», «есть гарантия».
  BOOLEAN
  /// Произвольная строка, когда перечислить варианты невозможно.
  TEXT
}

/// Характеристика категории: «Память» у телефона, «Пробег» у автомобиля.
///
/// Висит на категории и наследуется вниз по дереву: характеристики
/// «Телефонов» действуют и на их подкатегории. Так общее описывается
/// один раз, а частное добавляется там, где появляется.
model CategoryAttribute {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Устойчивое имя для адресов и фильтров: "brand", "storage".
  slug String
  name String
  kind AttributeKind @default(SELECT)

  /// Варианты для SELECT — по порядку показа.
  ///
  /// У зависимой характеристики вариант хранится с приставкой родителя
  /// через «::» — "Apple::iPhone 15". Иначе список моделей пришлось бы
  /// заводить отдельной таблицей ради той же пары «марка — модель».
  options   String[] @default([])
  /// Слаг характеристики, от которой зависит список вариантов: модель от марки.
  dependsOn String?
  /// Единица измерения для NUMBER: «км», «ГБ», «″».
  unit      String?

  /// Спрашивается ли при размещении обязательно.
  required   Boolean @default(false)
  /// Показывать ли шагом при выборе категории: так ищут марку и модель.
  isStep     Boolean @default(false)
  /// Годится ли как фильтр в выдаче.
  filterable Boolean @default(true)

  sortOrder Int @default(0)

  values ListingAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("category_attributes")
}

/// Значение характеристики у конкретного объявления.
///
/// Текст и число хранятся раздельно: по числам нужны диапазоны
/// («от 100 000 км»), а сравнивать их как строки нельзя — «9» окажется
/// больше «10».
model ListingAttribute {
  listingId   String
  attributeId String
  listing     Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attribute   CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  valueText   String?
  valueNumber Float?
  valueBool   Boolean?

  @@id([listingId, attributeId])
  @@index([attributeId, valueText])
  @@index([attributeId, valueNumber])
  @@map("listing_attributes")
}

/// Одно объявление может попадать в несколько категорий товаров.
model ListingCategory {
  listingId  String
  categoryId String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
  @@index([categoryId])
  @@map("listing_categories")
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url        String
  storageKey String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([listingId, sortOrder])
  @@map("listing_photos")
}

// ─────────────────────────── Отзывы ───────────────────────────

enum ReviewStatus {
  PENDING // ждёт модерации
  APPROVED // опубликован, учитывается в рейтинге
  REJECTED // отклонён модератором
}

/// Отзыв клиента. В рейтинг попадают только APPROVED.
model Review {
  id           String     @id @default(cuid())
  specialistId String
  userId       String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Оценка 1..5. Диапазон проверяется на уровне API (Prisma не умеет CHECK).
  rating Int
  text   String? @db.Text

  status         ReviewStatus @default(PENDING)
  /// Причина отклонения — показывается автору отзыва.
  moderationNote String?

  /// Публичный ответ специалиста. Виден всем рядом с отзывом.
  /// Мастер с одним резким отзывом и спокойным ответом вызывает больше
  /// доверия, чем мастер без отзывов вообще — без права ответа он беззащитен.
  replyText         String?   @db.Text
  repliedAt         DateTime?
  moderatedAt       DateTime?
  moderatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один отзыв на специалиста от одного пользователя.
  @@unique([specialistId, userId])
  @@index([status, createdAt])
  @@index([specialistId, status])
  @@map("reviews")
}

// ─────────────────────────── Активность пользователя ───────────────────────────

/// История просмотров для личного кабинета.
model ProfileView {
  id           String     @id @default(cuid())
  userId       String
  specialistId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  /// Один пользователь — одна запись на специалиста, обновляем время повторного захода.
  @@unique([userId, specialistId])
  @@index([userId, viewedAt])
  @@map("profile_views")
}

/// Избранное. В ТЗ прямо не заявлено, но дешёво и заметно улучшает удержание.
model Favorite {
  userId       String
  specialistId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, specialistId])
  @@index([specialistId])
  @@map("favorites")
}

// ─────────────────────────── Подписки ───────────────────────────

/// Отметка об оплаченном периоде размещения.
/// Деньги проходят мимо приложения — админ фиксирует факт оплаты вручную.
model Subscription {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  /// Название тарифа: "month", "quarter", "year".
  plan            String
  startsAt        DateTime
  endsAt          DateTime
  /// Сумма в минимальных единицах, для отчётности.
  amount          Int?
  currency        String   @default("RUB")
  /// Комментарий админа: способ оплаты, номер чека и т.п.
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  /// Оплата, которой продлена подписка. Пусто у выданных админом вручную —
  /// такие выдачи никуда не делись: ими закрывают спорные случаи и
  /// начисляют компенсации.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([specialistId, endsAt])
  @@map("subscriptions")
}

/// Состоявшаяся сделка по объявлению.
///
/// Право на отзыв даёт только она: без этого площадку зальют местью
/// и накрутками, а оценка перестанет что-либо значить. Сделку отмечает
/// продавец, когда снимает объявление с пометкой «продано» и выбирает
/// покупателя из тех, кто ему писал, — то есть из людей, с которыми
/// разговор действительно был.
///
/// Пара «объявление и покупатель» уникальна: продать одну вещь дважды
/// одному человеку нельзя, а две записи дали бы два отзыва за одну сделку.
model Deal {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("DealsAsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId  String
  buyer    User   @relation("DealsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  reviews UserReview[]

  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@index([buyerId])
  @@map("deals")
}

/// Отзыв одного участника сделки о другом.
///
/// Виден не сразу: пока вторая сторона не ответила своим отзывом,
/// он скрыт от всех, кроме автора. Иначе получивший единицу отвечает
/// тем же, и оценки превращаются в обмен ударами. Ждать бесконечно
/// тоже нельзя — через две недели отзыв открывается сам, даже если
/// вторая сторона промолчала.
model UserReview {
  id String @id @default(cuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("WrittenUserReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetId String
  target   User   @relation("ReceivedUserReviews", fields: [targetId], references: [id], onDelete: Cascade)

  rating Int
  text   String? @db.Text

  /// Момент, с которого отзыв виден всем. Пусто — ещё скрыт.
  revealedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Один отзыв на сделку от каждой стороны.
  @@unique([dealId, authorId])
  @@index([targetId, revealedAt])
  @@map("user_reviews")
}

// ─────────────────── Заявки на услугу ───────────────────

/// Чем кончилась заявка.
enum ServiceRequestStatus {
  /// Отправлена, мастер ещё не ответил.
  PENDING
  /// Мастер взялся — открылась переписка.
  ACCEPTED
  /// Мастер отказался.
  DECLINED
  /// Мастер промолчал дольше отведённого срока.
  EXPIRED
}

/// Заявка на услугу: заказчик просит, мастер соглашается.
///
/// Раньше переписку с мастером открывал сам заказчик, и мастер узнавал
/// об обращении только по сообщению — а мог не ответить вовсе. Заявка
/// делает согласие явным: пока мастер не сказал «беру», чата нет, и
/// заказчик не ждёт ответа в пустоту.
///
/// Срок ответа короткий намеренно. Услуга нужна сейчас, и заказчик,
/// не получив ответа за полчаса, пойдёт к следующему — так и должно
/// быть. Просроченная заявка не мешает отправить новую.
model ServiceRequest {
  id String @id @default(cuid())

  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ServiceRequests", fields: [clientId], references: [id], onDelete: Cascade)

  /// Что именно нужно — необязательно: часто всё ясно из самой анкеты.
  note String? @db.Text

  status ServiceRequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  /// До какого момента мастер может согласиться. Проверяется при чтении
  /// и при ответе: отдельная задача, которая ходила бы по базе и гасила
  /// просроченные, была бы лишним местом для поломки.
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([specialistId, status, createdAt])
  @@index([clientId, createdAt])
  @@map("service_requests")
}

// ─────────────────── Надо срочно ───────────────────

/// Чем кончился срочный вызов.
enum UrgentStatus {
  /// Ждёт, пока кто-нибудь возьмётся.
  OPEN
  /// Мастер взял заказ — дальше они разговаривают в чате.
  TAKEN
  /// Срок вышел, никто не взялся.
  EXPIRED
  /// Заказчик передумал.
  CANCELLED
}

/// Вызов мастера на сейчас.
///
/// Отличается от анкеты и от заявки тем, что адресован не одному
/// человеку, а всем подходящим сразу: когда прорвало трубу, выбирать
/// из каталога некогда. Берёт тот, кто первым согласился, — остальным
/// приходит «уже взяли», и это честнее, чем оставить их звонить
/// в занятую линию.
///
/// Название площадки — про это: NADO значит «надо сейчас», а не
/// «посмотрю на выходных».
model UrgentRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UrgentAsClient", fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  city        String
  title       String
  description String? @db.Text

  status UrgentStatus @default(OPEN)

  /// С какого момента человеку удобно. Пусто — хоть сейчас.
  /// Окно нужно тем, у кого срочность не в минутах, а в попадании
  /// в промежуток: «буду дома с двух до шести».
  neededFrom DateTime?

  /// До какого момента нужна помощь. После него вызов гаснет сам:
  /// «нужен электрик до восьми» в девять никому не интересен.
  neededBy DateTime

  /// Кто взял. Пусто, пока не взяли.
  takenById String?
  takenBy   User?     @relation("UrgentAsMaster", fields: [takenById], references: [id], onDelete: SetNull)
  takenAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, neededBy])
  @@index([userId, createdAt])
  @@map("urgent_requests")
}

// ─────────────────── Охота за спросом ───────────────────

/// Подписка на чужой спрос.
///
/// Человек говорит один раз: «я продаю велосипеды», «я электрик в Нижнем
/// Новгороде» — и получает уведомление, когда появляется подходящий
/// запрос. Не он ищет клиентов, а спрос находит его.
///
/// Это работает там, где витрина ещё не работает. Витрине нужен объём:
/// пока объявлений два десятка, ходить по ней незачем. А уведомление
/// полезно при любом количестве — даже один запрос в неделю стоит того,
/// чтобы держать приложение установленным.
model DemandWatch {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// За чем следим: за запросами на товары или за услугами.
  kind CategoryKind

  /// Категория, которая интересна. null — любая: так подписываются те,
  /// кому важен город, а не предмет.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Город. Пусто — вся страна: доставка и удалённая работа существуют.
  city String?

  /// Ключевое слово в заголовке. Пусто — без разбора.
  /// Нужно там, где категории мало: «велосипед» точнее, чем «спорт».
  keyword String?

  createdAt DateTime @default(now())

  @@index([kind, categoryId])
  @@index([userId])
  @@map("demand_watches")
}

// ─────────────────── Приглашения ───────────────────

/// Награда за приглашённых.
///
/// Строка появляется, когда человек добрал очередной рубеж, и остаётся
/// навсегда: это и запись о достижении, и защита от повторной выдачи.
/// Подарок вручается вручную — Telegram Premium стоит настоящих денег,
/// и решение об этом принимает человек, а не счётчик.
model ReferralAward {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Сколько приглашённых было достигнуто: 20, 50, 80.
  milestone Int

  createdAt DateTime  @default(now())
  /// Когда подарок действительно выдан. Пусто — ждёт вручения.
  grantedAt DateTime?

  /// Один рубеж — одна награда.
  @@unique([userId, milestone])
  @@index([grantedAt])
  @@map("referral_awards")
}

// ─────────────────── Рисованные картинки ───────────────────

/// Картинка, нарисованная по описанию пользователя.
///
/// Храним не ради истории, а потому что между «нарисовали» и «поставил
/// на анкету» проходит отдельное действие человека: он смотрит, решает
/// и только потом ставит. Без записи картинку не к чему привязать,
/// а описание — единственный способ разобраться, за что списаны звёзды,
/// если человек придёт с вопросом.
model GeneratedImage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Что человек попросил нарисовать — своими словами.
  prompt String @db.Text

  url String
  /// Ключ файла в хранилище: по одному URL файл не удалить.
  key String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("generated_images")
}

// ─────────────────────────── Оплата ───────────────────────────

/// Что человек покупает.
enum PaymentPurpose {
  /// Подписка специалиста: показ анкеты в каталоге и на карте.
  SPECIALIST_SUBSCRIPTION
  /// Объявление сверх бесплатного месячного лимита.
  LISTING_SLOT
  /// Продвижение объявления: подъём в начало списка на срок.
  LISTING_PROMOTION
  /// Пополнение кошелька: звёзды переходят на баланс и тратятся потом.
  WALLET_TOPUP
  /// Рисованная картинка для анкеты или запроса.
  IMAGE_GENERATION
}

/// Куда движутся звёзды на балансе.
enum WalletEntryKind {
  /// Пополнение звёздами Telegram.
  TOPUP
  /// Списание за покупку.
  SPEND
  /// Возврат — при отмене покупки или по решению администратора.
  REFUND
  /// Начисление администратором: компенсация, бонус, исправление ошибки.
  ADJUSTMENT
  /// Подарок площадки: кэшбек с покупки, приветственные звёзды.
  BONUS
}

/// Движение по кошельку.
///
/// Баланс хранится у пользователя числом, но каждое его изменение обязано
/// иметь здесь строку. Само по себе число ничего не объясняет: при споре
/// «я пополнял на триста» ответить нечем, если движения не записаны.
/// Остаток после операции хранится вместе с ней — так видно не только
/// что произошло, но и к чему это привело.
model WalletEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind         WalletEntryKind
  /// Со знаком: пополнение положительное, списание отрицательное.
  stars        Int
  /// Остаток после операции — для сверки и для истории в приложении.
  balanceAfter Int

  /// Человеческое описание: «Подписка на месяц», «Пополнение».
  title String

  /// Оплата, которой сделано пополнение. У списаний пусто.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("wallet_entries")
}

enum PaymentStatus {
  /// Счёт выставлен, человек его ещё не оплатил. Такие записи живут
  /// недолго и остаются как след неудавшейся попытки.
  PENDING
  /// Деньги получены, купленное выдано.
  PAID
  /// Возврат через Telegram. Купленное при этом отзывается.
  REFUNDED
}

/// Платёж звёздами Telegram.
///
/// Запись создаётся при выставлении счёта и завершается, когда Telegram
/// сообщит боту об оплате. Так у каждой оплаты есть заранее известное
/// назначение: подтверждение приходит отдельным сообщением, и без
/// сохранённого намерения было бы непонятно, за что именно заплатили.
model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose PaymentPurpose
  status  PaymentStatus  @default(PENDING)

  /// Сумма в звёздах. Валюта у Stars одна, но храним явно —
  /// когда добавится СБП, поле пригодится как есть.
  stars    Int
  currency String @default("XTR")

  /// Тариф: 'month' | 'quarter' | 'year' для подписки,
  /// 'week' | 'month' для продвижения. Для разового объявления пусто.
  plan String?

  /// Объявление, к которому относится оплата слота или продвижения.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  /// Специалист, чью подписку оплачивают.
  specialistId String?

  /// Полезная нагрузка счёта: по ней подтверждение находит эту запись.
  /// Уникальна, чтобы два счёта не сошлись в один платёж.
  invoicePayload String @unique

  /// Идентификатор платежа со стороны Telegram. Уникален — именно он
  /// защищает от двойного зачисления, если подтверждение придёт дважды.
  telegramChargeId String? @unique

  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  refundedAt DateTime?

  subscription Subscription?
  walletEntry  WalletEntry?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// ─────────────────────────── Переписка ───────────────────────────

/// Диалог между заказчиком и специалистом.
///
/// Общение происходит внутри приложения, а не во внешних мессенджерах:
/// так площадка видит переписку, может разобрать спорную ситуацию
/// и не теряет сделку, ушедшую в личные контакты.
model Conversation {
  id String @id @default(cuid())

  /// Предмет разговора: либо карточка специалиста, либо объявление.
  /// Ровно одно из полей заполнено — проверяется в коде, потому что
  /// Prisma не умеет описывать такое ограничение на уровне схемы.
  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)

  messages Message[]

  /// Денормализованные поля для списка диалогов: без них каждая строка
  /// списка требовала бы отдельного запроса за последним сообщением.
  lastMessageAt   DateTime?
  lastMessageText String?

  /// Непрочитанное считаем отдельно для каждой стороны.
  clientUnread     Int @default(0)
  specialistUnread Int @default(0)

  /// Диалог закрыт администрацией — писать нельзя, история сохраняется.
  isBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один диалог на предмет разговора: переписка должна быть сплошной,
  /// а не рассыпаться на треды при каждом обращении.
  @@unique([specialistId, clientId])
  @@unique([listingId, clientId])
  @@index([clientId, lastMessageAt])
  @@index([specialistId, lastMessageAt])
  @@index([listingId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  /// Текст, который видят собеседники: контакты в нём скрыты.
  text              String  @db.Text
  /// Исходник до вычистки. Нужен для разбора жалоб — без него нельзя
  /// доказать, что специалист уводил клиента с площадки.
  originalText      String? @db.Text
  /// В сообщении были контакты, и они скрыты.
  hasMaskedContacts Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─────────────────────────── Жалобы ───────────────────────────

enum ReportTarget {
  SPECIALIST
  REVIEW
}

enum ReportStatus {
  OPEN // ждёт рассмотрения
  RESOLVED // меры приняты
  DISMISSED // жалоба отклонена
}

/// Жалоба на карточку или отзыв.
///
/// Без неё модерация работает только на упреждение: администратор должен сам
/// наткнуться на нарушение. В каталоге с публичными контактами и текстами
/// от пользователей это неприемлемо — в том числе юридически.
model Report {
  id       String       @id @default(cuid())
  target   ReportTarget
  /// Идентификатор карточки или отзыва. Внешний ключ не ставим:
  /// поле указывает на разные таблицы в зависимости от target.
  targetId String

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  reason  String
  comment String? @db.Text

  status           ReportStatus @default(OPEN)
  resolutionNote   String?
  resolvedAt       DateTime?
  resolvedByUserId String?

  createdAt DateTime @default(now())

  /// Один пользователь — одна жалоба на объект: иначе жалобами можно
  /// завалить очередь модерации и утопить в ней настоящие нарушения.
  @@unique([reporterId, target, targetId])
  @@index([status, createdAt])
  @@index([target, targetId])
  @@map("reports")
}

// ─────────────────────────── Служебное ───────────────────────────

/// Журнал действий администраторов — нужен для разбора спорных ситуаций.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // "review.approve", "specialist.block", ...
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
