// Каталог специалистов — схема БД (PostgreSQL)
// Генерация клиента:  npm run db:generate -w apps/api
// Применение схемы:   npm run db:push -w apps/api

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Пользователи ───────────────────────────

enum Role {
  USER       // обычный клиент
  MODERATOR  // модерирует отзывы
  ADMIN      // полный доступ к админ-панели
}

/// Что пользователь выбрал на стартовом экране. Не влияет на права —
/// определяет только то, какой интерфейс ему показывать.
enum Onboarding {
  CLIENT      // ищет специалистов
  SPECIALIST  // сам оказывает услуги
  MARKET      // пришёл покупать или продавать товары
}

/// Пользователь Telegram. Создаётся автоматически при первом открытии Mini App.
model User {
  id           String  @id @default(cuid())
  /// Telegram user id. BigInt — id уже вышли за пределы int32.
  telegramId   BigInt  @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  languageCode String?
  isPremium    Boolean @default(false)
  role         Role    @default(USER)
  isBlocked    Boolean @default(false)
  /// Пользователь заблокировал бота или не начинал с ним чат.
  /// Telegram отвечает 403 — запоминаем, чтобы не тратить лимит запросов.
  botBlocked   Boolean @default(false)

  /// Сколько раз пользователь пытался передать контакты в обход правил.
  /// Первая попытка — повод объяснить правило, регулярные — повод
  /// показать пользователя администратору.
  contactAttempts Int @default(0)
  /// null — выбор ещё не сделан, показываем стартовый экран.
  onboardedAs  Onboarding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  /// Если пользователь сам является специалистом — обратная связь на карточку.
  specialist Specialist?
  reviews    Review[]
  views      ProfileView[]
  favorites  Favorite[]
  reports    Report[]
  conversations Conversation[] @relation("ClientConversations")
  messages      Message[]      @relation("SentMessages")
  listings      Listing[]

  @@index([role])
  @@map("users")
}

// ─────────────────────────── Категории ───────────────────────────

/// Что размещается в категории: услуги или товары.
/// Наборы разные — «Ремонт и стройка» как категория товара бессмысленна,
/// но админка и модель остаются общими.
enum CategoryKind {
  SERVICE
  PRODUCT
}

/// Категория: «Ремонт», «Красота» — для услуг; «Электроника», «Одежда» — для товаров.
model Category {
  id        String  @id @default(cuid())
  kind      CategoryKind @default(SERVICE)
  /// Человекочитаемый идентификатор для URL: "beauty", "repair".
  slug      String  @unique
  name      String
  /// Emoji или имя иконки из набора фронтенда.
  icon      String  @default("🔧")
  /// Родительская категория — на будущее, для подкатегорий. null = корневая.
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialists SpecialistCategory[]

  listings  ListingCategory[]

  @@index([kind, isActive, sortOrder])
  @@map("categories")
}

// ─────────────────────────── Специалисты ───────────────────────────

enum SpecialistStatus {
  DRAFT     // черновик, не виден в каталоге
  PENDING   // подана заявка, ждёт проверки админом
  ACTIVE    // опубликован
  HIDDEN    // скрыт админом или по окончании подписки
  BLOCKED   // заблокирован за нарушения
}

/// Карточка специалиста в каталоге.
model Specialist {
  id     String  @id @default(cuid())
  /// Telegram-аккаунт владельца карточки. null — карточку завёл админ вручную.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  slug        String  @unique
  /// Краткая строка под именем: «Мастер маникюра, 8 лет опыта».
  headline    String?
  about       String? @db.Text
  photoUrl    String?
  /// Ключ файла аватара в хранилище. Нужен, чтобы удалить прежний при замене:
  /// по одному URL это невозможно, у драйверов разные схемы адресов.
  photoKey    String?

  // — Локация —
  city    String
  address String?
  /// Координаты для карты и поиска «рядом». null — не показывается на карте.
  lat     Float?
  lng     Float?

  // — Контакты. Приложение не хранит переписку, только точки входа. —
  phone     String?
  telegram  String?  // @username или ссылка t.me
  whatsapp  String?  // номер в международном формате
  instagram String?
  website   String?

  status SpecialistStatus @default(PENDING)

  /// Анкета опубликована, но владелец её изменил — нужна повторная проверка.
  /// Карточка при этом остаётся видимой: снимать с публикации из-за правки
  /// опечатки слишком грубо, а изменения всё равно попадут к модератору.
  needsReview Boolean @default(false)

  /// Причина отклонения анкеты. Показывается владельцу, чтобы он понимал,
  /// что исправить, и мог подать её заново.
  rejectionReason String?

  /// Кто завёл карточку: сам специалист через приложение или администратор.
  isSelfRegistered Boolean @default(false)

  /// Денормализованный рейтинг: пересчитывается при модерации отзыва.
  /// Хранится здесь, чтобы сортировка и фильтры каталога не делали агрегат на лету.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  viewCount   Int   @default(0)

  /// Платная подписка. Оплата вне приложения, админ ставит отметку вручную.
  subscriptionUntil DateTime?
  /// Поднятие в выдаче для оплативших.
  isPromoted        Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  categories    SpecialistCategory[]
  services      Service[]
  photos        SpecialistPhoto[]
  reviews       Review[]
  views         ProfileView[]
  favorites     Favorite[]
  subscriptions Subscription[]
  conversations Conversation[]

  @@index([status, ratingAvg])
  @@index([status, needsReview])
  @@index([city, status])
  @@index([lat, lng])
  @@map("specialists")
}

/// Связь многие-ко-многим: специалист может работать в нескольких категориях.
model SpecialistCategory {
  specialistId String
  categoryId   String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([specialistId, categoryId])
  @@index([categoryId])
  @@map("specialist_categories")
}

/// Позиция прайс-листа. Цены информационные — платежи приложение не проводит.
model Service {
  id           String  @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Цена в минимальных единицах (копейках), чтобы не ловить ошибки float.
  priceAmount Int?
  currency    String  @default("RUB")
  /// true — «от 1500 ₽», false — фиксированная цена.
  priceIsFrom Boolean @default(false)
  sortOrder   Int     @default(0)

  @@index([specialistId, sortOrder])
  @@map("services")
}

/// Фотография в галерее работ.
model SpecialistPhoto {
  id           String  @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  url       String
  /// Ключ в хранилище — по нему файл удаляется вместе с записью.
  storageKey String?
  caption   String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  @@index([specialistId, sortOrder])
  @@map("specialist_photos")
}

// ─────────────────────────── Объявления ───────────────────────────

enum ListingStatus {
  DRAFT     // черновик
  PENDING   // ждёт проверки
  ACTIVE    // опубликовано
  SOLD      // продано, остаётся в истории продавца
  HIDDEN    // снято с публикации
  REJECTED  // отклонено модератором
}

enum ListingCondition {
  NEW           // новый
  USED_PERFECT  // как новый
  USED          // бывший в употреблении
}

/// Объявление о продаже товара.
///
/// Отдельно от карточки специалиста: у товара цена, состояние и признак
/// «продано», у специалиста — рейтинг, услуги и режим работы. Общая таблица
/// заставила бы половину полей быть пустыми у каждой из сторон.
model Listing {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  slug        String  @unique
  description String? @db.Text

  /// Цена в минимальных единицах (копейках) — как и у услуг,
  /// чтобы не ловить ошибки округления.
  priceAmount Int
  currency    String @default("RUB")
  /// Цена договорная: сумма показывается как ориентир.
  isNegotiable Boolean @default(false)

  condition ListingCondition @default(USED)
  city      String

  status          ListingStatus @default(PENDING)
  rejectionReason String?
  /// Опубликованное объявление изменили — нужна повторная проверка.
  needsReview     Boolean @default(false)

  viewCount Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  soldAt      DateTime?

  categories    ListingCategory[]
  photos        ListingPhoto[]
  conversations Conversation[]

  @@index([status, createdAt])
  @@index([city, status])
  @@index([userId])
  @@map("listings")
}

/// Одно объявление может попадать в несколько категорий товаров.
model ListingCategory {
  listingId  String
  categoryId String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
  @@index([categoryId])
  @@map("listing_categories")
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url        String
  storageKey String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([listingId, sortOrder])
  @@map("listing_photos")
}

// ─────────────────────────── Отзывы ───────────────────────────

enum ReviewStatus {
  PENDING   // ждёт модерации
  APPROVED  // опубликован, учитывается в рейтинге
  REJECTED  // отклонён модератором
}

/// Отзыв клиента. В рейтинг попадают только APPROVED.
model Review {
  id           String @id @default(cuid())
  specialistId String
  userId       String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Оценка 1..5. Диапазон проверяется на уровне API (Prisma не умеет CHECK).
  rating Int
  text   String? @db.Text

  status           ReviewStatus @default(PENDING)
  /// Причина отклонения — показывается автору отзыва.
  moderationNote   String?

  /// Публичный ответ специалиста. Виден всем рядом с отзывом.
  /// Мастер с одним резким отзывом и спокойным ответом вызывает больше
  /// доверия, чем мастер без отзывов вообще — без права ответа он беззащитен.
  replyText   String?   @db.Text
  repliedAt   DateTime?
  moderatedAt      DateTime?
  moderatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один отзыв на специалиста от одного пользователя.
  @@unique([specialistId, userId])
  @@index([status, createdAt])
  @@index([specialistId, status])
  @@map("reviews")
}

// ─────────────────────────── Активность пользователя ───────────────────────────

/// История просмотров для личного кабинета.
model ProfileView {
  id           String @id @default(cuid())
  userId       String
  specialistId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  /// Один пользователь — одна запись на специалиста, обновляем время повторного захода.
  @@unique([userId, specialistId])
  @@index([userId, viewedAt])
  @@map("profile_views")
}

/// Избранное. В ТЗ прямо не заявлено, но дешёво и заметно улучшает удержание.
model Favorite {
  userId       String
  specialistId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, specialistId])
  @@index([specialistId])
  @@map("favorites")
}

// ─────────────────────────── Подписки ───────────────────────────

/// Отметка об оплаченном периоде размещения.
/// Деньги проходят мимо приложения — админ фиксирует факт оплаты вручную.
model Subscription {
  id           String @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  /// Название тарифа: "month", "quarter", "year".
  plan      String
  startsAt  DateTime
  endsAt    DateTime
  /// Сумма в минимальных единицах, для отчётности.
  amount    Int?
  currency  String   @default("RUB")
  /// Комментарий админа: способ оплаты, номер чека и т.п.
  note      String?
  createdByUserId String?
  createdAt DateTime @default(now())

  @@index([specialistId, endsAt])
  @@map("subscriptions")
}

// ─────────────────────────── Переписка ───────────────────────────

/// Диалог между заказчиком и специалистом.
///
/// Общение происходит внутри приложения, а не во внешних мессенджерах:
/// так площадка видит переписку, может разобрать спорную ситуацию
/// и не теряет сделку, ушедшую в личные контакты.
model Conversation {
  id String @id @default(cuid())

  /// Предмет разговора: либо карточка специалиста, либо объявление.
  /// Ровно одно из полей заполнено — проверяется в коде, потому что
  /// Prisma не умеет описывать такое ограничение на уровне схемы.
  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)

  messages Message[]

  /// Денормализованные поля для списка диалогов: без них каждая строка
  /// списка требовала бы отдельного запроса за последним сообщением.
  lastMessageAt   DateTime?
  lastMessageText String?

  /// Непрочитанное считаем отдельно для каждой стороны.
  clientUnread     Int @default(0)
  specialistUnread Int @default(0)

  /// Диалог закрыт администрацией — писать нельзя, история сохраняется.
  isBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один диалог на предмет разговора: переписка должна быть сплошной,
  /// а не рассыпаться на треды при каждом обращении.
  @@unique([specialistId, clientId])
  @@unique([listingId, clientId])
  @@index([clientId, lastMessageAt])
  @@index([specialistId, lastMessageAt])
  @@index([listingId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  /// Текст, который видят собеседники: контакты в нём скрыты.
  text String @db.Text
  /// Исходник до вычистки. Нужен для разбора жалоб — без него нельзя
  /// доказать, что специалист уводил клиента с площадки.
  originalText String? @db.Text
  /// В сообщении были контакты, и они скрыты.
  hasMaskedContacts Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─────────────────────────── Жалобы ───────────────────────────

enum ReportTarget {
  SPECIALIST
  REVIEW
}

enum ReportStatus {
  OPEN      // ждёт рассмотрения
  RESOLVED  // меры приняты
  DISMISSED // жалоба отклонена
}

/// Жалоба на карточку или отзыв.
///
/// Без неё модерация работает только на упреждение: администратор должен сам
/// наткнуться на нарушение. В каталоге с публичными контактами и текстами
/// от пользователей это неприемлемо — в том числе юридически.
model Report {
  id       String       @id @default(cuid())
  target   ReportTarget
  /// Идентификатор карточки или отзыва. Внешний ключ не ставим:
  /// поле указывает на разные таблицы в зависимости от target.
  targetId String

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  reason  String
  comment String? @db.Text

  status           ReportStatus @default(OPEN)
  resolutionNote   String?
  resolvedAt       DateTime?
  resolvedByUserId String?

  createdAt DateTime @default(now())

  /// Один пользователь — одна жалоба на объект: иначе жалобами можно
  /// завалить очередь модерации и утопить в ней настоящие нарушения.
  @@unique([reporterId, target, targetId])
  @@index([status, createdAt])
  @@index([target, targetId])
  @@map("reports")
}

// ─────────────────────────── Служебное ───────────────────────────

/// Журнал действий администраторов — нужен для разбора спорных ситуаций.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // "review.approve", "specialist.block", ...
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
