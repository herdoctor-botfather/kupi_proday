# Путь указан целиком, а не просто «uploads/»: короткое правило исключает
# любую папку с таким именем, включая исходники apps/api/src/uploads.
# Из-за этого модуль загрузок однажды не попал в репозиторий, и сборка
# на сервере упала на отсутствующем импорте.
apps/api/uploads/
.logs/
