{
  "name": "@app/bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "ts-node --transpile-only src/setup.ts",
    "check:messages": "ts-node --transpile-only src/check-messages.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
