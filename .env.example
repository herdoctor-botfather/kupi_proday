# ─── Общие ───
NODE_ENV=development

# ─── База данных ───
# Локально через Docker: postgresql://app:app@localhost:5432/tgspec
# Облако (Neon/Supabase): строка подключения из панели, обязательно с ?sslmode=require
DATABASE_URL="postgresql://app:app@localhost:5432/tgspec"

# ─── Telegram ───
# Токен бота от @BotFather. Им же подписывается initData — это ключ авторизации.
TELEGRAM_BOT_TOKEN=""
# Имя бота без @, нужно для Login Widget в админке
TELEGRAM_BOT_USERNAME=""
# Публичный HTTPS-адрес Mini App (Telegram не открывает http)
MINIAPP_URL="https://example.com"

# ─── API ───
API_PORT=3000
# Секрет для подписи JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET="change-me-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"
# Домены, которым разрешён доступ к API (через запятую)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ─── Администрирование ───
# Telegram id первых администраторов через запятую. Применяется скриптом db:seed.
ADMIN_TELEGRAM_IDS=""
# Только для локальной разработки: позволяет войти в админку без Telegram.
# В production переменная игнорируется.
ADMIN_DEV_TOKEN=""

# Уведомления пользователям через бота. false отключает отправку —
# удобно при прогоне тестов, чтобы не слать сообщения в реальный Telegram.
NOTIFICATIONS_ENABLED="true"

# ─── Хранилище файлов ───
# local — файлы на диске рядом с приложением, годится только для разработки.
# s3 — любое S3-совместимое хранилище: Cloudflare R2, Yandex Object Storage,
#      Backblaze B2, MinIO. Отличаются только endpoint и регион.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_PUBLIC_URL="/uploads"

# Заполняются при STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Публичный адрес бакета или CDN перед ним
S3_PUBLIC_URL=""
# true для MinIO и провайдеров без адресации по поддомену бакета
S3_FORCE_PATH_STYLE="false"

# ─── Карты ───
# Ключ JS API Яндекс.Карт: https://developer.tech.yandex.ru/services/
VITE_YANDEX_MAPS_API_KEY=""

# ─── Фронтенд ───
# Дополнительные домены, с которых разрешено открывать dev-сервер
# (кроме известных туннелей — они разрешены по умолчанию).
TUNNEL_HOSTS=""
# Куда dev-сервер проксирует /api. Только для разработки, на клиент не попадает.
API_PROXY_TARGET="http://localhost:3000"
# Базовый адрес API для браузера. Пусто = тот же домен, что и у страницы —
# так работает и dev-сервер с прокси, и боевой nginx. Заполнять нужно,
# только если API вынесен на отдельный домен.
VITE_API_URL=""
# Имя бота для Telegram Login Widget в админке (без @).
# Домен админки нужно прописать боту командой /setdomain у @BotFather.
VITE_TELEGRAM_BOT_USERNAME=""
